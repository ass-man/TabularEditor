/// Customer attributes used for segmentation, buying group analysis, and account performance.
table D_Customer
	lineageTag: 9c167730-5b08-461d-8b96-b8b578dba65b

	/// Distinct customers in the customer dimension.
	measure 'Customer Count' = DISTINCTCOUNT('D_Customer'[WWI Customer ID])
		formatString: #,0
		displayFolder: Customer
		lineageTag: c8d581d5-a152-4627-b64e-b4b1186ebcf2

	/// Customers with sales in the current filter context.
	measure 'Active Sales Customers' = DISTINCTCOUNT('F_Sale'[D_Customer_SID])
		formatString: #,0
		displayFolder: Customer
		lineageTag: 3fc43b28-df1e-4c87-acb2-075d6b9201cf

	/// Net sales divided by active sales customers.
	measure 'Sales per Active Customer' = DIVIDE([Net Sales], [Active Sales Customers])
		formatString: $#,0;(-$#,0);$#,0
		displayFolder: Customer
		lineageTag: 7ab893e2-8aed-4ffd-8dd6-8682407a2ce9

	column D_Customer_SID
