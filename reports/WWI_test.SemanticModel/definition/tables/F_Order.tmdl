/// Order-line fact table for order intake, demand, and fulfillment analysis.
table F_Order
	lineageTag: 793bfdfa-3cba-489c-a2aa-2205997714dc

	/// Distinct order-line key count for order intake analysis.
	measure 'Order Count' = DISTINCTCOUNT('F_Order'[Order Key])
		formatString: #,0
		displayFolder: Orders
		lineageTag: 8fac3cc1-fb3c-438d-9868-aa62b18b07da

	/// Total ordered quantity.
	measure 'Order Quantity' = SUM('F_Order'[Quantity])
		formatString: #,0
		displayFolder: Orders
		lineageTag: f5edcba4-753e-4fb8-bb66-3a94854c9805

	/// Gross order value including tax.
	measure 'Order Value' = SUM('F_Order'[Total Including Tax])
		formatString: $#,0;(-$#,0);$#,0
		displayFolder: Orders
		lineageTag: 2e35266f-212c-4c2b-8755-c2e0986299ec

	/// Order value excluding tax.
	measure 'Net Order Value' = SUM('F_Order'[Total Excluding Tax])
		formatString: $#,0;(-$#,0);$#,0
		displayFolder: Orders
		lineageTag: 895e264e-2f60-46d0-9fef-e06a5ffdb1a3

	/// Average gross value per order.
	measure 'Average Order Value' = DIVIDE([Order Value], [Order Count])
		formatString: $#,0;(-$#,0);$#,0
		displayFolder: Orders
		lineageTag: a1306686-30cc-46d8-9f93-4ac9b858ab6e

	/// Tax amount on orders.
	measure 'Order Tax' = SUM('F_Order'[Tax Amount])
		formatString: $#,0;(-$#,0);$#,0
		displayFolder: Orders
		lineageTag: 908349d0-3169-4861-9485-537b3d90ed20

