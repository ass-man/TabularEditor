/// Financial transaction fact table for receivables, balances, and payment-method analysis.
table F_Transaction
	lineageTag: 9363cb38-687f-4a49-9dcf-1ca4daa38b01

	/// Gross transaction amount.
	measure 'Transaction Amount' = SUM('F_Transaction'[Total Including Tax])
		formatString: $#,0;(-$#,0);$#,0
		displayFolder: Finance
		lineageTag: e15d00ea-e695-4477-ba4b-03ee6cf3b453

	/// Transaction amount excluding tax.
	measure 'Net Transaction Amount' = SUM('F_Transaction'[Total Excluding Tax])
		formatString: $#,0;(-$#,0);$#,0
		displayFolder: Finance
		lineageTag: 82e7f438-eec3-4b6e-a555-983fdcc50636

	/// Outstanding balance as a percentage of gross transaction amount.
	measure 'Outstanding Balance %' = DIVIDE([Outstanding Balance Amount], [Transaction Amount])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Finance
		lineageTag: 18f25113-2f65-483f-9400-e20e7a3e8806

	/// Distinct financial transaction count.
	measure 'Transaction Count' = DISTINCTCOUNT('F_Transaction'[Transaction Key])
		formatString: #,0
		displayFolder: Finance
		lineageTag: 686b8511-72e2-407e-af43-01c290c773c1

	/// Transactions not finalized.
	measure 'Open Transactions' = CALCULATE([Transaction Count], 'F_Transaction'[Is Finalized] = FALSE())
		formatString: #,0
		displayFolder: Finance
		lineageTag: 29f4d843-d7dc-4ebf-985c-a53e1186cf8c

	measure 'Outstanding Balance Amount' = SUM('F_Transaction'[Outstanding Balance])
		formatString: $#,0;(-$#,0);$#,0
		lineageTag: fa381394-0761-4602-9a4e-7c8e0cd8b531

	column 'Transaction Key'
