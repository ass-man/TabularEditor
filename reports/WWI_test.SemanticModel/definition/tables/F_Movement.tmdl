/// Stock movement fact table for inventory flow and transaction-volume analysis.
table F_Movement
	lineageTag: f017a76a-32a5-41b2-ae29-0298f51f8173

	/// Total stock movement quantity.
	measure 'Movement Quantity' = SUM('F_Movement'[Quantity])
		formatString: #,0
		displayFolder: Inventory Movement
		lineageTag: 3dd4e174-a777-44bb-bbdb-8ab2375ab66a

	/// Distinct stock movement count.
	measure 'Movement Count' = DISTINCTCOUNT('F_Movement'[Movement Key])
		formatString: #,0
		displayFolder: Inventory Movement
		lineageTag: 846b090b-9447-4c41-99ab-1a98a944e4c9

	column 'Movement Key'
		dataType: int64
		isHidden
		isNullable: false
		formatString: 0
		sourceProviderType: bigint
		lineageTag: c794b1cf-ae3d-439a-892e-f33b2616bb1c
		summarizeBy: count
		sourceColumn: Movement Key

		annotation SummarizationSetBy = Automatic

	column Date
