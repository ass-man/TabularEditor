	partition 'delivery F_StockHolding' = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("localhost", "WideWorldImportersDW"),
				    delivery_F_StockHolding = Source{[Schema="delivery",Item="F_StockHolding"]}[Data]
				in
