/// Purchase order fact table for supplier fulfillment and receiving analysis.
table F_Purchase
	lineageTag: 980f6870-b13a-4ff0-abbf-f3f61fa793ac

	/// Distinct purchase order fact rows.
	measure 'Purchase Order Count' = DISTINCTCOUNT('F_Purchase'[Purchase Key])
		formatString: #,0
		displayFolder: Purchasing
		lineageTag: 6be880c6-82b7-4ae3-a3d6-a494d5d7f2ea

	/// Received outers divided by ordered outers.
	measure 'Receipt Completion %' = DIVIDE([Purchase Received Outers], [Purchase Ordered Outers])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Purchasing
		lineageTag: 8f5a6e5e-4808-4e5a-90f7-88d86a81fa2f

	/// Finalized purchase order rows.
	measure 'Finalized Purchase Orders' = CALCULATE([Purchase Order Count], 'F_Purchase'[Is Order Finalized] = TRUE())
		formatString: #,0
		displayFolder: Purchasing
		lineageTag: 8be0dab3-1379-4946-83db-7e48fbbedf50

	measure 'Purchase Ordered Quantity' = SUM('F_Purchase'[Ordered Quantity])
		formatString: #,0
		lineageTag: da1fad7c-9a23-4029-89a6-9c123ef28ffc

	measure 'Purchase Ordered Outers' = SUM('F_Purchase'[Ordered Outers])
		formatString: #,0
		lineageTag: 03382f70-7b7d-48e8-beeb-ac059fca4862

	measure 'Purchase Received Outers' = SUM('F_Purchase'[Received Outers])
		formatString: #,0
		lineageTag: 1045bdf0-90b0-44d5-9dcb-31d70d3895f5

	column 'Purchase Key'
		dataType: int64
		isHidden
		isNullable: false
		formatString: 0
		sourceProviderType: bigint
		lineageTag: 1b5d309a-ba90-4055-bf26-382fae1c26f0
		summarizeBy: count
		sourceColumn: Purchase Key

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		isNullable: false
		formatString: Long Date
		sourceProviderType: date
		lineageTag: 4dccf8d9-4217-42a2-875a-a2bf8015f0be
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

