	partition 'delivery F_Purchase' = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("localhost", "WideWorldImportersDW"),
				    delivery_F_Purchase = Source{[Schema="delivery",Item="F_Purchase"]}[Data]
				in
